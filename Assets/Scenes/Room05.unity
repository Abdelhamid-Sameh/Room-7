  m_Script: {fileID: 11500000, guid: f9327e2fe08defc40bedece4dd510f3d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableItem
  prompt: Interact
  kind: 0
  title: "\u0648\u0631\u0642\u0629 \u0627\u0644\u0623\u0628\u0644\u0629"
  subtitle: 
  readPrompt: Read the teacher's note
  body: "\u0644\u0642\u064A\u062A \u0627\u0644\u0648\u0631\u0642 \u062F\u0647 \u0628\u064A\u062A\u0646\u0642\u0644
    \u0641\u0649 \u0627\u0644\u0641\u0635\u0644 \u0627\u0644\u0646\u0647\u0627\u0631\u062F\u0647
    \u0648\u0627\u062A\u0628\u0639\u062B\u0631 \u0641\u0649 \u0643\u0644 \u062D\u062A\u0629.\n\u0627\u0644\u0625\u0634\u0627\u0639\u0629
    \u062F\u0627\u064A\u0645\u064B\u0627 \u0628\u062A\u0628\u062F\u0623 \u0645\u0646
    \u062D\u062F \u0648\u0627\u062D\u062F.\n\n\u0627\u0644\u0644\u0649 \u0639\u0627\u064A\u0632
    \u0627\u0644\u0634\u0631\u064A\u0637 \u0627\u0644\u0644\u0649 \u0641\u0649 \u062F\u0631\u062C\u0649\u060C
    \u064A\u0643\u062A\u0628 \u0623\u0631\u0642\u0627\u0645 \u0627\u0644\u062F\u0643\u0643
    \u0628\u0627\u0644\u062A\u0631\u062A\u064A\u0628 :\n\u0645\u0646 \u0627\u0644\u0644\u0649
    \u0628\u062F\u0623 \u0627\u0644\u0643\u0644\u0627\u0645 ... \u0644\u062D\u062F
    \u0622\u062E\u0631 \u0648\u0627\u062D\u062F \u0648\u0635\u0644\u0647."
  clueId: 
