  readPrompt: Unfold the crumpled paper
  body: "\u0647\u0646\u0627\n\u0625\u064A\u0627\u062F \u0642\u0627\u0644\u0644\u0649
    \u0625\u0646 \u0639 \u0643\u062A\u0628 \u062C\u0648\u0627\u0628 \u0644\u0640
    \u0647\u0640\n\u0648\u0642\u0627\u0644 \u0647\u064A\u062A\u062C\u0648\u0632\u0647\u0627
