  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f9327e2fe08defc40bedece4dd510f3d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableItem
  prompt: Interact
  kind: 0
  title: "\u0646\u0631\u0633\u064A\u0633"
  subtitle: 
  readPrompt: Read the paper
  body: "\u0646\u0627\u0631\u0643\u064A\u0633\u0648\u0633 \u0647\u0648 \u0634\u0627\u0628
    \u0648\u0633\u064A\u0645 \u0645\u0646 \u0627\u0644\u0623\u0633\u0627\u0637\u064A\u0631
    \u0627\u0644\u0625\u063A\u0631\u064A\u0642\u064A\u0629\u060C \u0627\u0628\u0646
    \u0625\u0644\u0647 \u0627\u0644\u0646\u0647\u0631 \u0643\u064A\u0641\u064A\u0633\u0648\u0633
    \u0648\u0627\u0644\u062D\u0648\u0631\u064A\u0629 \u0644\u064A\u0631\u064A\u0648\u0628\u064A\u060C
    \u0627\u0634\u062A\u0647\u0631 \u0628\u062C\u0645\u0627\u0644\u0647 \u0627\u0644\u0627\u0633\u062A\u062B\u0646\u0627\u0626\u064A
    \u0648\u063A\u0631\u0648\u0631\u0647 \u0627\u0644\u0630\u064A \u062F\u0641\u0639\u0647
    \u0644\u0631\u0641\u0636 \u0645\u0634\u0627\u0639\u0631 \u062C\u0645\u064A\u0639
    \u0645\u0646 \u0623\u062D\u0628\u0648\u0647\u060C \u0628\u0645\u0627 \u0641\u064A
    \u0630\u0644\u0643 \u0627\u0644\u062D\u0648\u0631\u064A\u0629 \u0625\u064A\u0643\u0648
    \u0627\u0644\u062A\u064A \u0643\u0627\u0646\u062A \u062A\u062D\u0628\u0647 \u0628\u062C\u0646\u0648\u0646.\n\u0639\u0646\u062F\u0645\u0627
    \u0644\u0627\u062D\u0638\u062A \u0627\u0644\u0622\u0644\u0647\u0629 \u063A\u0637\u0631\u0633\u062A\u0647\u060C
    \u0642\u0631\u0631\u062A \u0639\u0642\u0627\u0628\u0647 \u0639\u0628\u0631 \u0625\u064A\u0642\u0627\u0639\u0647
    \u0641\u064A \u062D\u0628 \u0627\u0646\u0639\u0643\u0627\u0633 \u0635\u0648\u0631\u062A\u0647
    \u0641\u064A \u0645\u064A\u0627\u0647 \u0628\u0631\u0643\u0629 \u0635\u0627\u0641\u064A\u0629.
    \u0644\u0645 \u064A\u0633\u062A\u0637\u0639 \u0646\u0631\u0633\u064A\u0633 \u0627\u0644\u0627\u0628\u062A\u0639\u0627\u062F
    \u0639\u0646 \u0630\u0644\u0643 \u0627\u0644\u0648\u0647\u0645 \u0627\u0644\u062C\u0645\u064A\u0644\u060C
    \u0645\u0645\u0627 \u0623\u062F\u0649 \u0625\u0644\u0649 \u0630\u0628\u0648\u0644
    \u062C\u0633\u062F\u0647 \u0648\u0645\u0648\u062A\u0647 \u0645\u0646 \u0634\u062F\u0629
    \u0627\u0644\u062D\u0632\u0646 \u0623\u0648 \u0627\u0644\u062C\u0648\u0639\u060C
    \u0644\u062A\u062A\u062D\u0648\u0644 \u0627\u0644\u0622\u0644\u0647\u0629 \u062C\u0633\u062F\u0647
    \u0628\u0639\u062F \u0648\u0641\u0627\u062A\u0647 \u0625\u0644\u0649 \u0632\u0647\u0631\u0629
    \u0627\u0644\u0646\u0631\u062C\u0633\u060C \u0627\u0644\u062A\u064A \u0623\u0635\u0628\u062D\u062A
    \u0631\u0645\u0632\u0627\u064B \u0644\u0644\u0623\u062F\u0628 \u0648\u0627\u0644\u0646\u0641\u0633\u064A\u0629
    \u0644\u0640 \u062D\u0628 \u0627\u0644\u0630\u0627\u062A \u0627\u0644\u0645\u0641\u0631\u0637."
  clueId: A paper about Narcissus, left on a seat
