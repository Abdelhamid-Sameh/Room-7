  m_Script: {fileID: 11500000, guid: f9327e2fe08defc40bedece4dd510f3d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ReadableItem
  prompt: Interact
  kind: 1
  title: Clara
  subtitle: online
  readPrompt: Pick up the phone
  body: "\u0645\u064A\u0646\u0627 \u0627\u0646\u062A \u0635\u0627\u062D\u0649 \u061F\n>\u0622\u0647
    \u0644\u064A\u0647 \u061F\n\u0633\u0645\u0639\u062A \u0635\u0648\u062A \u0635\u0648\u064A\u062A
    \u0641\u0649 \u0627\u0644\u0637\u0631\u0642\u0629\n>\u062A\u0627\u0646\u0649
    \u061F!\n\u0622\u0647 \u0648 \u0634\u0643\u0644\u0647 \u0635\u0648\u062A \u0627\u0644\u0628\u0646\u062A
    \u0627\u0644\u0649 \u0628\u062A\u0646\u0636\u0641. \u0644\u0645\u0627 \u0628\u0635\u064A\u062A
    \u0645\u0646 \u0627\u0644\u0639\u064A\u0646 \u0634\u0648\u0641\u062A \u0627\u0644\u0645\u062F\u064A\u0631
    \u0628\u062A\u0627\u0639\u0647\u0627\n>\u062A\u0641\u062A\u0643\u0631\u0649 \u0628\u064A\u0636\u0627\u064A\u0642\u0647\u0627
    \u061F\n\u0627\u0646\u0627 \u0634\u0648\u0641\u062A\u0647\u0627 \u0644\u0645\u0627
    \u0631\u062C\u0639\u0646\u0627 \u0645\u0646 \u0628\u0631\u0627\u060C \u0648\u0634\u0647\u0627
    \u0643\u0627\u0646 \u0623\u0628\u064A\u0636 \u0648\u0645\u0627\u0633\u0643\u0629
    \u0646\u0641\u0633\u0647\u0627 \u0628\u0627\u0644\u0639\u0627\u0641\u064A\u0629\n>\u0631\u0628\u0646\u0627
    \u064A\u0633\u062A\u0631 \u0639\u0644\u064A\u0647\u0627\u060C \u0627\u062D\u0646\u0627
    \u0644\u0627\u0632\u0645 \u0646\u0628\u0644\u063A \u0627\u0644\u0645\u0648\u0636\u0648\u0639
    \u062F\u0647."
  clueId: Mina and Clara heard screaming in the corridor and saw Malak's manager
    there
